{
  "name": "telegram-url-resolver-bot",
  "version": "1.0.0",
  "description": "Telegram bot that resolves URL redirect chains and returns final destination",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "telegram-bot",
    "url-resolver",
    "redirect-chain"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
